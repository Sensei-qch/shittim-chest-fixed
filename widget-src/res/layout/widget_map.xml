<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <LinearLayout android:id="@+id/wg_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView android:id="@+id/wg_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_map_title"
            android:textColor="#FF2F5FA8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView android:id="@+id/wg_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_input"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_primary"
            android:visibility="gone"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:maxLines="1" />

        <TextView android:id="@+id/wg_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_open"
            android:textColor="#FF2F5FA8"
            android:textSize="10sp"
            android:background="@drawable/widget_btn"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 地图画面 + 叠层地名。ImageView 由 WidgetHelper 用 assets/maps/*.webp 生成的位图填充 -->
    <FrameLayout android:id="@+id/wg_map_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp">

        <ImageView android:id="@+id/wg_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_map_fallback"
            android:contentDescription="@string/widget_map_title" />

        <TextView android:id="@+id/wg_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:text="@string/widget_map_default"
            android:background="@drawable/widget_label_bg"
            android:textColor="#FF27435F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </FrameLayout>

    <TextView android:id="@+id/wg_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_map_hint"
        android:textColor="#FF7089A6"
        android:textSize="10sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout android:id="@+id/wg_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">

        <TextView android:id="@+id/wg_btn1"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:text="@string/widget_map_prev_short"
            android:textColor="#FF24508C" android:textSize="12sp" android:maxLines="1"
            android:gravity="center" android:background="@drawable/widget_btn"
            android:paddingTop="4dp" android:paddingBottom="4dp" />

        <TextView android:id="@+id/wg_btn2"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
            android:text="@string/widget_map_next_short"
            android:textColor="#FF24508C" android:textSize="12sp" android:maxLines="1"
            android:gravity="center" android:background="@drawable/widget_btn"
            android:paddingTop="4dp" android:paddingBottom="4dp" />

        <TextView android:id="@+id/wg_btn3"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:text="@string/widget_map_refresh_short"
            android:textColor="#FF24508C" android:textSize="12sp" android:maxLines="1"
            android:gravity="center" android:background="@drawable/widget_btn"
            android:paddingTop="4dp" android:paddingBottom="4dp" />

        <TextView android:id="@+id/wg_btn4"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:text="@string/widget_map_list_short"
            android:textColor="#FF24508C" android:textSize="12sp" android:maxLines="1"
            android:gravity="center" android:background="@drawable/widget_btn"
            android:paddingTop="4dp" android:paddingBottom="4dp" />
    </LinearLayout>

</LinearLayout>
